            <zone fixed-size='700' h='66038' hidden-by-user='true' id='176' is-fixed='true' param='vert' type-v2='layout-flow' w='51245' x='24964' y='14387'>
              <zone fixed-size='29' h='3892' hidden-by-user='true' id='183' is-fixed='true' type-v2='text' w='48903' x='26135' y='16274'>
                <formatted-text>
                  <run fontcolor='#0f3460' fontname='Roboto Medium' fontsize='18'>Dashboard Glossary</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='margin-bottom' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='2' h='236' hidden-by-user='true' id='184' is-fixed='true' type-v2='empty' w='48903' x='26135' y='20166'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='background-color' value='#dee2e6' />
                </zone-style>
              </zone>
              <zone fixed-size='144' forceUpdate='true' h='18868' hidden-by-user='true' id='177' is-fixed='true' type-v2='text' w='48903' x='26135' y='20402'>
                <formatted-text>
                  <run fontcolor='#0f3460' fontname='Roboto Medium' fontsize='12'>1. Time and Variance Metrics</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• CY (Current Year): </run>
                  <run fontcolor='#495057' fontsize='10'>The selected month and year currently being analyzed.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• PY (Previous Year): </run>
                  <run fontcolor='#495057' fontsize='10'>The exact same month in the prior year. Used for seasonal comparison.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• MoM (Month-over-Month): </run>
                  <run fontcolor='#495057' fontsize='10'>The percentage change in performance compared to the immediate prior month.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• YoY (Year-over-Year): </run>
                  <run fontcolor='#495057' fontsize='10'>The percentage change in performance compared to the same month in the previous year.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='margin-top' value='8' />
                  <format attr='margin-bottom' value='8' />
                </zone-style>
              </zone>
              <zone fixed-size='1' h='1061' hidden-by-user='true' id='185' is-fixed='true' type-v2='empty' w='48903' x='26135' y='39270'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#dee2e6' />
                </zone-style>
              </zone>
              <zone fixed-size='113' forceUpdate='true' h='15212' hidden-by-user='true' id='181' is-fixed='true' type-v2='text' w='48903' x='26135' y='40331'>
                <formatted-text>
                  <run fontcolor='#0f3460' fontname='Roboto Medium' fontsize='12'>2. Core Trade Metrics</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• Total Value (USD): </run>
                  <run fontcolor='#495057' fontsize='10'>The total financial value of the exported goods, calculated in USD Dollars (FOB).</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• Total Volume: </run>
                  <run fontcolor='#495057' fontsize='10'>The physical weight of the goods shipped, measured in Net Tons.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• Unit Price:</run>
                  <run fontcolor='#495057' fontsize='10'> A derived efficiency metric calculated as Total Value divided by Total Volume (USD/Ton).</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='margin-top' value='8' />
                  <format attr='margin-bottom' value='8' />
                </zone-style>
              </zone>
              <zone fixed-size='1' h='1061' hidden-by-user='true' id='186' is-fixed='true' type-v2='empty' w='48903' x='26135' y='55543'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#dee2e6' />
                </zone-style>
              </zone>
              <zone fixed-size='185' forceUpdate='true' h='21816' hidden-by-user='true' id='182' is-fixed='true' type-v2='text' w='48903' x='26135' y='56604'>
                <formatted-text>
                  <run fontcolor='#0f3460' fontname='Roboto Medium' fontsize='12'>3. Classifications &amp; Methodology</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• SH2 (Harmonized System): </run>
                  <run fontcolor='#495057' fontsize='10'>The standard 2-digit international classification system used to categorized traded products.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>• ASEAN: </run>
                  <run fontcolor='#495057' fontsize='10'>Associacion of Southeast Nations. For this dashboard, includes Brunei, Cambodia, Indonesia, Laos, Malaysia, Myanmar, the Philippines, Singapore, Thailand, and Vietnam.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'><![CDATA[• Outlier Threshold (+<[Parameters].[Parameter 5]> – <[Parameters].[p.classification | top (copy)_1606988433268737]>):  ]]></run>
                  <run fontcolor='#495057' fontsize='10'>Variances are visually flagged in </run>
                  <run fontcolor='#00796b' fontname='Roboto Medium' fontsize='10'>Teal</run>
                  <run fontcolor='#495057' fontsize='10'> (positive) or </run>
                  <run fontcolor='#d9534f' fontname='Roboto Medium' fontsize='10'>Red</run>
                  <run fontcolor='#495057' fontsize='10'> (negative) only when the Month-over-Month change exceeds the defined threshold between </run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'>+&lt;[Parameters].[Parameter 5]&gt;</run>
                  <run fontcolor='#495057' fontsize='10'> and </run>
                  <run fontcolor='#495057' fontname='Roboto Medium' fontsize='10'><![CDATA[<[Parameters].[p.classification | top (copy)_1606988433268737]>]]></run>
                  <run fontcolor='#495057' fontsize='10'>. Flucutations within this interval are considered normal market variance and remain </run>
                  <run fontcolor='#616161' fontname='Roboto Medium' fontsize='10'>Gray</run>
                  <run fontcolor='#495057' fontsize='10'>.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                </zone-style>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='6' />
                <format attr='padding' value='16' />
                <format attr='background-color' value='#ffffff' />
              </zone-style>
            </zone>
          </zone>
