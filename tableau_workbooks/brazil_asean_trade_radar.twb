            </column>
            <column caption='L.val vs vol | SM &gt; PM ? (tbl)' datatype='boolean' name='[L.volume | SM | MoM (tbl) (copy)_1392304204656656]' role='measure' type='nominal'>
              <calculation class='tableau' formula='(ZN([Calculation_1392304200388615]) - LOOKUP(ZN([Calculation_1392304200388615]), -1)) &gt; 0'>
                <table-calc ordering-type='Rows' />
