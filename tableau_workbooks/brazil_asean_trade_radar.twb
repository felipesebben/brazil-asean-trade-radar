      <column caption='k.dyn metric | SM | MoM | padding (right)' datatype='real' name='[Calculation_0147664465121288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(ABS([k.volume | SM | MoM (copy)_0964594338635779]))*1.1'>
