      <aliases enabled='yes' />
      <column caption='L.set filter' datatype='boolean' name='[Calculation_0523966655692801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = 0 AND [Co Sh2 Set]&#13;&#10;THEN FALSE&#13;&#10;ELSE TRUE&#13;&#10;END' />
      </column>
      <column caption='k.dyn metric | SM' datatype='real' name='[Calculation_0964594334040064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 0 THEN [Calculation_2162235935637507]&#13;&#10;    WHEN 1 THEN [k.value | SM (copy)_2162235937226759]&#13;&#10;    WHEN 2 THEN [Calculation_2162235937910794]&#13;&#10;END' />
      </column>
      <column caption='k.dyn metric | SM | MoM | classification' datatype='integer' name='[Calculation_0964594340114437]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [k.volume | SM | MoM (copy)_0964594338635779] &gt;= 0.2&#13;&#10;    THEN 1&#13;&#10;ELSEIF [k.volume | SM | MoM (copy)_0964594338635779] &gt;= -0.2&#13;&#10;    THEN 0&#13;&#10;ELSE -1&#13;&#10;END' />
      </column>
      <column caption='L.is 12TM' datatype='boolean' name='[Calculation_1369488782331904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[Parameters].[Date Parameter], [date]) &lt;= 0&#13;&#10;AND &#13;&#10;DATEDIFF(&quot;month&quot;,[Parameters].[Date Parameter], [date]) &gt;= -11' />
      </column>
      <column caption='L.value | SM &gt; PM?' datatype='boolean' name='[Calculation_1392304198688773]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2162235935637507] &gt; [k.value | SM (copy)_2162235936403461]' />
      </column>
      <column caption='L.value | SM | MoM (tbl)' datatype='boolean' name='[Calculation_1392304199028742]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN(SUM([cy_value_usd])) - LOOKUP(ZN(SUM([cy_value_usd])), -1)) &gt; 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k.cy val vs vol' datatype='real' name='[Calculation_1392304200388615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cy_value_usd])&#13;&#10;/&#13;&#10;SUM([cy_weight_ton])' />
      </column>
      <column caption='k.val vs vol | SM &gt; PM?' datatype='integer' name='[Calculation_1392304203300878]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SIGN([k.volume | SM | MoM (copy)_1392304201342987])' />
      </column>
      <column caption='k.dyn metric | MoM (abs) | rank | SM' datatype='integer' name='[Calculation_1574275484463104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([k.dyn metric | SM | MoM (copy)_1102308362227713], &quot;desc&quot;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k.dyn metric | SM | MoM (abs) | max padding' datatype='real' name='[Calculation_1574275487014920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([k.dyn metric | SM | MoM (copy)_1102308362227713]) *1.2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k.dyn metric | SM | MoM (abs) | max padding (bottom)' datatype='real' name='[Calculation_1574275491323924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(ABS([k.dyn metric | SM | MoM (copy)_1102308362227713]))*1.2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k.value | max padding' datatype='real' name='[Calculation_1574275496476693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(MAX(SUM([cy_value_usd]),SUM([py_value_usd])))*1.2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k.dyn metric | CY' datatype='real' name='[Calculation_1746347654770692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 0 THEN SUM([cy_value_usd])&#13;&#10;    WHEN 1 THEN SUM([cy_weight_ton])&#13;&#10;    WHEN 2 THEN SUM([cy_value_usd])/SUM([cy_weight_ton])&#13;&#10;END' />
      </column>
      <column caption='d.date | most recent' datatype='date' name='[Calculation_2162235931430912]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED :&#13;&#10;    MAX(&#13;&#10;        CASE [cy_value_usd] &gt; 0&#13;&#10;            WHEN TRUE THEN [date]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='L.is selected month | SM' datatype='boolean' name='[Calculation_2162235933929474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = [Parameters].[Date Parameter]' />
      </column>
      <column caption='k.value | SM' datatype='integer' name='[Calculation_2162235935637507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [Calculation_2162235933929474]&#13;&#10;        WHEN TRUE THEN [cy_value_usd]&#13;&#10;    END&#13;&#10;    )' />
      </column>
      <column caption='k.value vs vol | SM' datatype='real' name='[Calculation_2162235937910794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2162235935637507]&#13;&#10;/&#13;&#10;[k.value | SM (copy)_2162235937226759]' />
      </column>
      <column caption='k.value | YoY' datatype='real' default-format='*▲ +0.0;▼ -0.0%;0%' name='[Calculation_2162235939651600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2162235935637507] - [k.value | SM (copy)_2162235936964614])&#13;&#10;/&#13;&#10;ABS([k.value | SM (copy)_2162235936964614])' />
      </column>
      <column caption='m.BAN' datatype='spatial' name='[Calculation_2188075383996416]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT(0.9, 0.0)' />
      </column>
      <column caption='k.value | SM | formatted' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2188075384242177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS([Calculation_2162235935637507]) &gt;= 1000000000&#13;&#10;    THEN [Calculation_2162235935637507] / 1000000000&#13;&#10;ELSEIF ABS([Calculation_2162235935637507]) &gt;= 1000000&#13;&#10;    THEN [Calculation_2162235935637507] / 1000000&#13;&#10;ELSEIF ABS([Calculation_2162235935637507]) &gt;= 1000&#13;&#10;    THEN [Calculation_2162235935637507] / 1000&#13;&#10;ELSE [Calculation_2162235935637507]&#13;&#10;END' />
      </column>
      <column caption='L.is previous month | PM' datatype='boolean' name='[L.is_selected_month_SM (copy)_2162235935920132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[date]) = DATEADD(&quot;month&quot;, -1, [Parameters].[Date Parameter])' />
      </column>
      <column caption='L.dyn metric | SM &gt; PM? (tbl)' datatype='boolean' name='[L.val vs vol | SM &gt; PM ? (tbl) (copy)_1746347655696390]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN([Calculation_1746347654770692]) - LOOKUP(ZN([k.dyn metric | CY (copy)_1746347655090181]), -1)) &gt; 0'>
          <table-calc ordering-type='Rows' />
