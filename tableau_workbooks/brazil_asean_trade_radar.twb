        <calculation class='tableau' formula='(ZN([Calculation_1392304200388615]) - LOOKUP(ZN([Calculation_1392304200388615]), -1))/ ABS(LOOKUP(ZN([Calculation_1392304200388615]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
