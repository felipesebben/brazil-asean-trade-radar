        <calculation class='tableau' formula='IF [k.volume | SM | MoM (copy)_0964594338635779] &gt;= [Parameters].[Parameter 5]&#13;&#10;    THEN 1&#13;&#10;ELSEIF [k.volume | SM | MoM (copy)_0964594338635779] &gt;= [Parameters].[p.classification | top (copy)_1606988433268737]&#13;&#10;    THEN 0&#13;&#10;ELSE -1&#13;&#10;END' />
