              <calculation class='tableau' formula='MAKEPOINT(0.9, 0.0)' />
            </column>
            <column caption='L.dzv | selected metric = volume' datatype='boolean' name='[L.dzv | selected metric = export (copy)_1683130331910145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = 1' />
