            </column>
            <column caption='Cy Value Usd' datatype='integer' name='[cy_value_usd]' role='measure' type='quantitative' />
            <column caption='Cy Weight Ton' datatype='real' name='[cy_weight_ton]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='k.volume | MoM' datatype='real' name='[k.value | MoM (copy)_0453326920167427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([cy_weight_ton])) - LOOKUP(ZN(SUM([cy_weight_ton])), -1))/ ABS(LOOKUP(ZN(SUM([cy_weight_ton])),-1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='k.volume | MoM | classification' datatype='integer' name='[k.value | MoM | classification (copy)_0453326921125894]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [k.value | MoM (copy)_0453326920167427] &gt;= [Parameters].[Parameter 5]&#13;&#10;THEN 1&#13;&#10;ELSEIF [k.value | MoM (copy)_0453326920167427] &gt;= [Parameters].[p.classification | top (copy)_1606988433268737]&#13;&#10;THEN 0&#13;&#10;ELSE -1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='k.volume | SM' datatype='real' name='[k.value | SM (copy)_2162235937226759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [Calculation_2162235933929474]&#13;&#10;        WHEN TRUE THEN [cy_weight_ton]&#13;&#10;    END&#13;&#10;    )' />
            </column>
            <column caption='k.volume | max padding' datatype='real' name='[k.value | max padding (copy)_0672676301213696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(MAX(SUM([cy_weight_ton]),SUM([py_weight_ton])))*1.2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='k.volume | YoY' datatype='real' default-format='*+0.0%;-0.0%;0%' name='[k.volume | SM | MoM (copy)_0987417575514166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cy_weight_ton]) - SUM([py_weight_ton]))&#13;&#10;/&#13;&#10;ABS(SUM([py_weight_ton]))' />
            </column>
            <column caption='k.volume | min padding' datatype='real' name='[k.volume | max padding (copy)_0672676301385729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MIN(MIN(SUM([cy_weight_ton]),SUM([py_weight_ton])))*0.8'>
                <table-calc ordering-type='Rows' />
