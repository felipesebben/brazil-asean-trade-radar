            <column caption='k.volume | PM' datatype='real' name='[k.quantity | SM (copy)_2162235937374216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [L.is_selected_month_SM (copy)_2162235935920132]&#13;&#10;        WHEN TRUE THEN [cy_weight_ton]&#13;&#10;    END&#13;&#10;    )' />
            </column>
            <column caption='s.volume | MoM | classification (tooltip context)' datatype='string' name='[k.value | MoM | classification (tooltip context) (copy)_0987417561866289]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [k.value | SM | MoM (copy)_1392304197603331] &gt;= [Parameters].[Parameter 5]&#13;&#10;THEN &quot;an out outlier increase (exceeds &quot; + STR([Parameters].[Parameter 5]*100) + &quot;% threshold)&quot;&#13;&#10;ELSEIF [k.value | SM | MoM (copy)_1392304197603331] &gt;= [Parameters].[p.classification | top (copy)_1606988433268737]&#13;&#10;THEN &quot;a normal market fluctuation (within &quot; + STR([Parameters].[p.classification | top (copy)_1606988433268737]*100) + &quot;% – +&quot;  + STR([Parameters].[Parameter 5]*100) + &quot;%)&quot;&#13;&#10;ELSE &quot;an out outlier decrease (exceeds &quot; + STR([Parameters].[p.classification | top (copy)_1606988433268737]*100) + &quot;% threshold)&quot; &#13;&#10;END' />
            </column>
            <column caption='k.volume | SM' datatype='real' name='[k.value | SM (copy)_2162235937226759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [Calculation_2162235933929474]&#13;&#10;        WHEN TRUE THEN [cy_weight_ton]&#13;&#10;    END&#13;&#10;    )' />
            </column>
            <column caption='k.volume | SM | MoM' datatype='real' default-format='*▲ +0.0;▼ -0.0%;0%' name='[k.value | SM | MoM (copy)_1392304197603331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([k.value | SM (copy)_2162235937226759] - [k.quantity | SM (copy)_2162235937374216])&#13;&#10;/&#13;&#10;ABS([k.quantity | SM (copy)_2162235937374216])' />
            </column>
            <column caption='k.volume | SM | MoM | classification' datatype='integer' name='[k.value | SM | MoM | classification (copy)_1683130334019590]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [k.value | SM | MoM (copy)_1392304197603331] &gt;= [Parameters].[Parameter 5]&#13;&#10;    THEN 1&#13;&#10;ELSEIF [k.value | SM | MoM (copy)_1392304197603331] &gt;= [Parameters].[p.classification | top (copy)_1606988433268737]&#13;&#10;    THEN 0&#13;&#10;ELSE -1&#13;&#10;END' />
            </column>
            <column caption='k.volume | SM | formatted' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[k.value | SM | formatted (copy)_1392304196780032]' role='measure' type='quantitative'>
